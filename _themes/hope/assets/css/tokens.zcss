// tokens.zcss
//
// Design tokens for the oxygen docs theme: colors, fonts, spacing, radii,
// shadows and fixed dimensions. Light values live on :root; the dark palette
// is applied when <html data-theme="dark"> is set by main.js.
//
// Dependencies: none (imported first by main.zcss)

$font-sans: 'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
$font-mono: 'Inconsolata', ui-monospace, 'Cascadia Code', 'SF Mono', Consolas, monospace;

:root {
  --font-sans: $font-sans;
  --font-mono: $font-mono;

  // Surfaces
  --bg:          #f6f7f9;
  --bg-soft:     #edeff4;
  --card:        #ffffff;
  --border:      #e3e6ec;
  --border-soft: #eceef3;

  // Text
  --text:        #2f333b;
  --text-soft:   #5b6370;
  --text-faint:  #8a93a1;

  // Brand accent (overridable via [params.colors] in _config.toml)
  --accent:      #4f6ef7;
  --accent-soft: #eef1fe;
  --accent-line: #c8d4ff;
  --on-accent:   #ffffff;

  // Code
  --code-bg:     #f4f5f8;
  --code-border: #e5e8ef;
  --code-text:   #39415f;
  --code-key:    #7c5cff;

  // Feedback
  --ok:     #1f9d55;
  --warn:   #b7791f;
  --danger: #d64545;
  --info:   #2b6cb0;

  // Elevation
  --shadow:    0 1px 3px rgba(18, 25, 40, 0.06), 0 1px 2px rgba(18, 25, 40, 0.04);
  --shadow-lg: 0 10px 30px rgba(18, 25, 40, 0.10);

  // Shape
  --radius:     10px;
  --radius-sm:  6px;

  // Layout dimensions
  --sidebar-w:  276px;
  --toc-w:      260px;
  --header-h:   60px;
  --content-w:  840px;
  --page-gap:   28px;

  // Motion
  --transition: 0.18s ease;
}

html[data-theme="dark"] {
  --bg:          #17181d;
  --bg-soft:     #1e2027;
  --card:        #212329;
  --border:      #31343d;
  --border-soft: #2a2d35;

  --text:        #e6e8ee;
  --text-soft:   #a9afbb;
  --text-faint:  #767e8c;

  --accent:      #8299ff;
  --accent-soft: #2a3050;
  --accent-line: #3b4470;
  --on-accent:   #11141f;

  --code-bg:     #181a21;
  --code-border: #2c2f39;
  --code-text:   #c9d2f0;
  --code-key:    #a78bfa;

  --ok:     #4ade80;
  --warn:   #fbbf24;
  --danger: #f87171;
  --info:   #60a5fa;

  --shadow:    0 1px 3px rgba(0, 0, 0, 0.45);
  --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.55);
}
