// tokens.zcss
//
// Design tokens for the docs theme, blending a LaTeX-paper typographic
// voice (serif throughout, booktabs tables, restrained radius) with the
// Victorian-botanical palette (warm parchment surfaces, deep green ink,
// antique gold accents). Light values live on :root; the dark palette is
// applied when <html data-theme="dark"> is set by main.js.
//
// Dependencies: none (imported first by main.zcss)

$font-serif: 'Source Serif 4', 'Noto Serif SC', Georgia, 'Times New Roman', serif;
$font-mono: 'Inconsolata', ui-monospace, 'Cascadia Code', 'SF Mono', Consolas, monospace;

:root {
  // Serif everywhere: paper style forbids sans headings, botanical forbids
  // sans for headings too, so UI text shares the serif stack.
  --font-sans: $font-serif;
  --font-mono: $font-mono;

  // Surfaces — warm parchment
  --bg:          #f6f1e6;
  --bg-soft:     #efe8d8;
  --card:        #fffdf8;
  --border:      #e2d8c2;
  --border-soft: #ece4d1;

  // Text — warm ink
  --text:        #24241f;
  --text-soft:   #5a564a;
  --text-faint:  #8b8572;

  // Brand — botanical green with gold emphasis
  --accent:      #2d4a2d;
  --accent-soft: #e6ece0;
  --accent-line: #c3d0b8;
  --on-accent:   #f7f2e6;
  --gold:        #8b6914;
  --gold-soft:   #f4ecd6;

  // Code — parchment-tinted
  --code-bg:     #f3edde;
  --code-border: #e3dac4;
  --code-text:   #3b392f;
  --code-key:    #7a5c12;

  // Feedback — muted, warm-leaning semantic hues
  --ok:     #2e7d32;
  --warn:   #9a6b10;
  --danger: #b3402a;
  --info:   #166a6a;

  // Elevation — very soft warm shadows; paper stays flat
  --shadow:    0 1px 2px rgba(62, 51, 22, 0.05), 0 2px 6px rgba(62, 51, 22, 0.06);
  --shadow-lg: 0 6px 20px rgba(62, 51, 22, 0.10);

  // Shape — restrained radius, never pills
  --radius:     8px;
  --radius-sm:  4px;

  // Layout dimensions
  --sidebar-w:  276px;
  --toc-w:      260px;
  --header-h:   60px;
  --content-w:  840px;
  --page-gap:   28px;

  // Motion
  --transition: 0.18s ease;
}

html[data-theme="dark"] {
  --bg:          #1b1b17;
  --bg-soft:     #24231e;
  --card:        #26251f;
  --border:      #3a372e;
  --border-soft: #302e26;

  --text:        #e7e2d4;
  --text-soft:   #b0aa98;
  --text-faint:  #837d6a;

  --accent:      #9dbf8e;
  --accent-soft: #2b3526;
  --accent-line: #41543a;
  --on-accent:   #171b12;
  --gold:        #c8a24c;
  --gold-soft:   #37301a;

  --code-bg:     #20201c;
  --code-border: #343129;
  --code-text:   #d4cdbb;
  --code-key:    #c8a24c;

  --ok:     #7bbf6f;
  --warn:   #d3a94f;
  --danger: #e08a72;
  --info:   #6bb5b5;

  --shadow:    0 1px 2px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 6px 20px rgba(0, 0, 0, 0.45);
}
