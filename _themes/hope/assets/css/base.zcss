// base.zcss
//
// Reset, typography and shared element styling for the docs theme.
// Serif type throughout, booktabs-style tables (horizontal rules only) and
// theorem-like blockquotes follow the LaTeX-paper voice; parchment surfaces
// follow the botanical palette. Everything here is content-agnostic.
//
// Dependencies: tokens.zcss

*, *::before, *::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

// Respect users who ask for less motion: paper pages do not need to animate.
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

body {
  margin: 0;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.75;
  color: var(--text);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  transition: background var(--transition), color var(--transition);
}

h1, h2, h3, h4, h5, h6 {
  margin: 0 0 0.5em;
  line-height: 1.35;
  font-weight: 700;
  color: var(--text);
}

// The page title carries the botanical green; sections stay in ink.
h1 { font-size: 1.85rem; color: var(--accent); }
h2 { font-size: 1.42rem; margin-top: 2rem; }
h3 { font-size: 1.16rem; margin-top: 1.6rem; }
h4 { font-size: 1rem; }

p { margin: 0 0 1rem; }

a {
  color: var(--accent);
  text-decoration: none;
}

// Antique gold appears only on hover, so blue-ish clutter never shows.
a:hover {
  text-decoration: underline;
  color: var(--gold);
}

ul, ol {
  margin: 0 0 1rem;
  padding-left: 1.5rem;
}

li { margin: 0.2rem 0; }

// Theorem-style callout: parchment field with a green spine, echoing the
// Definition/Remark boxes of paper layouts instead of a plain border.
blockquote {
  margin: 1.2rem 0;
  padding: 0.7rem 1.1rem;
  background: var(--bg-soft);
  border: 1px solid var(--accent-line);
  border-left: 3px solid var(--accent);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  color: var(--text-soft);
}

blockquote p:last-child { margin-bottom: 0; }

hr {
  border: none;
  border-top: 1px solid var(--border);
  margin: 2rem 0;
}

// ── Code ──────────────────────────────────────────────

code {
  font-family: var(--font-mono);
  font-size: 0.88em;
  background: var(--code-bg);
  color: var(--code-key);
  padding: 0.14em 0.4em;
  border-radius: var(--radius-sm);
  border: 1px solid var(--code-border);
}

pre {
  position: relative;
  margin: 1rem 0;
  padding: 1rem 1.1rem;
  background: var(--code-bg);
  border: 1px solid var(--code-border);
  border-radius: var(--radius-sm);
  overflow-x: auto;
  line-height: 1.55;
}

pre code {
  display: block;
  padding: 0;
  background: none;
  border: none;
  color: var(--code-text);
  font-size: 0.86rem;
}

pre code.language-shell:before,
pre code.language-bash:before,
pre code.language-fsharp:before,
pre code.language-njk:before {
  display: block;
  margin-bottom: 0.6rem;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-faint);
  content: attr(class);
}

// ── Tables (booktabs: horizontal rules only) ──────────
// Heavy rules at top and bottom, a single thin rule under the header row,
// and no vertical lines or zebra striping.

table {
  width: 100%;
  margin: 1.2rem 0 1.5rem;
  border-collapse: collapse;
  font-size: 0.92rem;
  border-top: 2px solid var(--text);
  border-bottom: 2px solid var(--text);
}

th, td {
  padding: 0.55rem 0.9rem;
  text-align: left;
  vertical-align: top;
  border: none;
}

th {
  border-bottom: 1px solid var(--text);
  font-weight: 600;
  color: var(--accent);
}

// ── Images ────────────────────────────────────────────

img {
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-sm);
}
